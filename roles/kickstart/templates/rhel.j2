label kvmhost1
  menu label Install KVM Host #1
  kernel images/rhel/9/x86_64/vmlinuz
  append initrd=images/rhel/9/x86_64/initrd.img net.ifnames=0 zram.enabled=0 biosdevname=0 noipv6 ksdevice=eth0 inst.ks={{linux_install_server_url}}/ks-configs/kvmhost1-ks.cfg

