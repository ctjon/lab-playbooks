# Generated by Anaconda 41.35
# Generated by pykickstart v3.58
#version=DEVEL

# Keyboard layouts
keyboard --vckeymap=us --xlayouts='us'
# System language
lang en_US.UTF-8

# Network information
network  --hostname=server1.{{my_network_domain_name}} --bootproto=static --device=eth0 --gateway={{my_network_gateway}} --ip={{my_network_short_net}}.9 --nameserver={{my_network_dns_servers|join(",")}} --netmask={{my_network_netmask}} --activate

# Use network installation
url --url="{{linux_install_server_url}}/fedora/releases/41/Everything/x86_64/os"

%packages
@^server-product-environment
@headless-management

%end

# Run the Setup Agent on first boot
firstboot --enable

# Generated using Blivet version 3.11.0
ignoredisk --only-use=nvme0n1
# Partition clearing information
clearpart --all --initlabel
# Disk partitioning information
part pv.889 --fstype="lvmpv" --ondisk=nvme0n1 --grow

part /boot --fstype="xfs" --ondisk=nvme0n1 --size=768 --label=BOOT
part biosboot --fstype="biosboot" --ondisk=nvme0n1 --size=2
volgroup rootvg --pesize=4096 pv.889
logvol /var/log --fstype="xfs" --size=1024 --label="log" --name=loglv --vgname=rootvg
logvol /opt --fstype="xfs" --size=300 --label="opt" --name=optlv --vgname=rootvg
logvol / --fstype="xfs" --size=1024 --label="root" --name=rootlv --vgname=rootvg
logvol /var/cache --fstype="xfs" --size=4096 --label="cache" --name=cachelv --vgname=rootvg
logvol /var/lib/libvirt/images --fstype="xfs" --size=102400 --label="images" --name=imageslv --vgname=rootvg
logvol /home --fstype="xfs" --size=5120 --label="home" --name=homelv --vgname=rootvg
logvol /export --fstype="xfs" --size=300 --label="export" --name=exportlv --vgname=rootvg
logvol /var/lib/tftpboot --fstype="xfs" --size=2048 --label="tftpboot" --name=tftpbootlv --vgname=rootvg
logvol swap --fstype="swap" --size=65536 --name=swaplv --vgname=rootvg
logvol /usr --fstype="xfs" --size=8192 --label="usr" --name=usrlv --vgname=rootvg
logvol /var --fstype="xfs" --size=1024 --label="var" --name=varlv --vgname=rootvg
logvol /tmp --fstype="xfs" --size=10240 --label="tmp" --name=tmplv --vgname=rootvg

timesource --ntp-server={{my_ntp_server}}
# System timezone
timezone America/Phoenix --utc
reboot

# Root password
rootpw --iscrypted {{root_pw_hash}}

# Define user
user --groups=wheel --name={{user_name}} --password={{user_pw_hash}} --iscrypted --gecos="{{gecos_name}}"

%post
# install ssh key for {{user_name}}
curl {{config_files_url}}/{{user_name}}-server0-id_rsa.pub -o /home/{{user_name}}/.ssh/authorized_keys  --create-dirs
curl  {{config_files_url}}/{{user_name}}-x1carbon-id_rsa.pub >> /home/{{user_name}}/.ssh/authorized_keys
curl  {{config_files_url}}/{{user_name}}-mbp-id_rsa.pub >> /home/{{user_name}}/.ssh/authorized_keys
chown -R {{user_name}}:{{group_name}} /home/{{user_name}}/.ssh
chmod 700 /home/{{user_name}}/.ssh
chmod 600 /home/{{user_name}}/.ssh/authorized_keys
restorecon -RFv /home/{{user_name}}/.ssh/authorized_keys
%end

