  kernel images/rhel/8/x86_64/vmlinuz
  append initrd=images/rhel/8/x86_64/initrd.img net.ifnames=0 biosdevname=0 noipv6 keymap=us lang=en_US ksdevice=eth0 ip=dhcp inst.repo={{linux_install_server_url}}/rhel/8/x86_64 rescue

#
# Server1-RHEL9-BIOS
#
label server1-rhel9-bios
  menu label RHEL9 on Server1 w/BIOS (server1-rhel9-bios-ks.cfg)
  kernel images/rhel/9/x86_64/vmlinuz
  append initrd=images/rhel/9/x86_64/initrd.img net.ifnames=0 zram.enabled=0 biosdevname=0 noipv6 ksdevice=eth0 inst.ks={{linux_install_server_url}}/ks-configs/server1-rhel9-bios-ks.cfg

#
#
# Server1-RHEL8-BIOS
