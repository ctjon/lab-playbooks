# {{ansible_managed}}

# DHCP range
{% for item in dnsmasq_dhcp_interfaces %}
# {{item.name}}
dhcp-range={{item.name}},{{item.dhcp_start}},{{item.dhcp_end}},{{item.lease}}
dhcp-option={{item.name}},option:ntp-server,{{item.ntp_server}}
dhcp-option={{item.name}},option:router,{{item.router}}
{% endfor %}

