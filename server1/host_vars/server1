#
# host_vars file for server1
#

personal_server: true
work_server: false
test_nmcli: false

use_ssh_agent: yes
copy_ssh_keys: yes
setup_ansible_config: yes
setup_git_update: yes
ssh_private_key_list:
  - ctjon.pem
  - ctjon-github_rsa

ssh_public_key_list:
  - ctjon-github_rsa

enable_public_sshd: true

################################################################################
# Trusted Network Interface Configuration Parameters                           #
################################################################################
my_network_interface: eth0
my_network_ipaddr: 172.16.1.9
my_bridge_name: br0
my_network_firewall_zone: public

################################################################################
# VirtServer Parameters                                                        #
################################################################################
vm_storage_vg: rootvg
vm_storage_lv_size: 128G
virt_nets: null
