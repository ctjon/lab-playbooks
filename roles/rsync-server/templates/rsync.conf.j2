log file = /var/log/rsync.log
pid file = /var/run/rsyncd.pid
lock file = /var/run/rsync.lock

[archive]
        path = /export/archive
        comment = Server0 Archive Repo
        read only = yes
        hosts allow = {{my_network_subnet}}
        hosts deny = *

