# {{ansible_managed}}

tftp-root=/var/lib/tftpboot
log-dhcp
enable-tftp
#dhcp-boot:undionly.kpxe,,{{my_network_ipaddr}}
dhcp-no-override
dhcp-option=6,{{my_network_dns_servers|join(",")}}

# inspect the vendor class string and match the text to set the tag
dhcp-vendorclass=BIOS,PXEClient:Arch:00000
dhcp-vendorclass=UEFI32,PXEClient:Arch:00006
dhcp-vendorclass=UEFI,PXEClient:Arch:00007
dhcp-vendorclass=UEFI64,PXEClient:Arch:00009

# Set the boot file name based on the matching tag from the vendor class (above)
dhcp-boot=net:BIOS,pxelinux.0,,{{my_network_ipaddr}}
dhcp-boot=net:UEFI32,x86-efi/ipxe-i386.efi,,{{my_network_ipaddr}}
dhcp-boot=net:UEFI,x86_64-efi/ipxe-x86_64.efi,,{{my_network_ipaddr}}
dhcp-boot=net:UEFI64,x86_64-efi/ipxe-x86_64.efi,,{{my_network_ipaddr}}


# PXE menu.  The first part is the text displayed to the user.  The second is the timeout, in seconds.
#
pxe-prompt="Press F8 for boot menu", 3
# The known types are x86PC, PC98, IA64_EFI, Alpha, Arc_x86,
# Intel_Lean_Client, IA32_EFI, BC_EFI, Xscale_EFI and X86-64_EFI
# This option is first and will be the default if there is no input from the user.

pxe-prompt="PXE Booting from {{ansible_hostname}}",5
pxe-service=x86PC,'PXE Boot (x86 BIOS)',pxelinux.0
pxe-service=X86-64_EFI, "Boot x86-64_EFI grubx64.efi", grubx64.efi

#dhcp-range={{my_network_ipaddr}},proxy,{{my_network_netmask}}
dhcp-range={{my_network_ipaddr}},{{my_network_netmask}}
